s": [{"type": "pdf", "content": "enpe8n7le02ob12re7pdf01.pdf"}], "type": "question"}], "responses": [{"_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1, "id": 0}], "id": 0}], "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " Getting to know more about liability caps"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "id": 12}], "stimuli": [{"_data": [], "id": 0, "contents": [{}], "type": "welcome", "template_override": 1}, {"template_override": 1, "contents": [{"value": {"audiosrc": "enpe8n7le02ob12re2aud01", "images": [{"time": "0", "image": "enpe8n7le02ob12re2img01.jpg", "id": 0, "text": "I want to introduce this lecture by asking this question: Is the liability of a software agreement supposed to be limited? Well, software license agreements have provisions that limit the amount of the software's provider liability to the customer for damage or loss. This is called liability cap.  But, how is the liability cap supposed to be calculated? Many license agreements contain a liability cap which is determined depending on the amount of fees paid by the customer during a stated period."}, {"time": "29000", "image": "enpe8n7le02ob12re2img02.jpg", "id": 1, "text": "You can even limit the type of damages that could be recovered. This would limit the liability and recover to only certain damages. In this sense, is the amount of the cap supposed to change? Totally. The amount of the cap is variable. So, if an event of loss happens in the first three months of the agreement, the fees and the capped amount could be less than the fee paid afterwards in the term of the contract. On the other hand, if the customer accepts a cap of liability, it's advisable to include a floor amount in the cap."}, {"time": "60300", "image": "enpe8n7le02ob12re2img03.jpg", "id": 2, "text": "It means that the cap of liability is the greater of a specified amount in the next 12 months. Which things are supposed to be excluded from the cap on liability? It is mandatory to exclude some head of loss, like a breach of privacy, confidentiality, and personal injury. All in all, a financial cap either limits or expands the liability. Whatever limitation of liability and indemnification that is applied must be understood and agreed by both parties to avoid claims by the licensor."}], "coverimg": "enpe8n7le02ob12re2img01.jpg"}, "type": "slideshow"}], "type": "audio", "_data": [], "id": 1, "title": ""}, {"template_override": 1, "contents": [{"value": {"video_src": "enpe8n7le02ob12re5vsc01", "images": [{"time": "0", "image": "", "id": 0, "text": ""}]}, "type": "video"}], "type": "video", "_data": [], "id": 4, "title": ""}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}